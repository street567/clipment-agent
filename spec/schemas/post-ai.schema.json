{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": ".clipment/posts/<target>/ai.json",
  "type": "object",
  "required": [
    "version",
    "updated"
  ],
  "properties": {
    "schema": {
      "type": "integer"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ko"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "text"
        ],
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "author": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
