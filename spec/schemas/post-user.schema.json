{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": ".clipment/posts/<target>/user.json",
  "type": "object",
  "required": [
    "fields",
    "updated"
  ],
  "properties": {
    "schema": {
      "type": "integer"
    },
    "fields": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "text"
            ],
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "extras": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "seenAI": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "authorName": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
