{
  "manifest_version": "0.2",
  "name": "clipment",
  "display_name": "Clipment",
  "version": "__VERSION__",
  "description": "아이폰 Clipment 앱에서 남긴 영상 시점 코멘트를 읽고, 답글·진행 보고·새 버전 게시·대본(보이스) 초안·음성 생성, 루트 정리를 하는 MCP 서버. 파일 편집/렌더(셸)는 하지 않습니다.",
  "author": { "name": "street567" },
  "license": "SEE LICENSE IN LICENSE",
  "server": {
    "type": "node",
    "entry_point": "server/index.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.mjs"],
      "env": { "CLIPREV_AGENT": "claude" }
    }
  },
  "tools": [
    { "name": "list_workspaces", "description": "등록된 워크스페이스 목록" },
    { "name": "index_root", "description": "루트 폴더 인덱스 갱신" },
    { "name": "list_projects", "description": "리뷰 프로젝트 목록" },
    { "name": "list_versions", "description": "프로젝트 버전 목록" },
    { "name": "list_comments", "description": "코멘트 목록" },
    { "name": "get_thread", "description": "코멘트 스레드" },
    { "name": "get_frame", "description": "코멘트 시점 프레임 (ffmpeg 필요)" },
    { "name": "reply", "description": "코멘트에 답글" },
    { "name": "report_progress", "description": "진행 상황 보고" },
    { "name": "publish_version", "description": "새 버전 게시 (ffmpeg 필요)" },
    { "name": "upload_version", "description": "업로드용 버전 조회·지정" },
    { "name": "preview_quality", "description": "작업용 화질 조회·지정" },
    { "name": "wait_for_requests", "description": "대기 요청 조회" },
    { "name": "get_preferences", "description": "작업 지침 읽기" },
    { "name": "set_preferences", "description": "작업 지침 고치기" },
    { "name": "script_get", "description": "대본(보이스) 읽기" },
    { "name": "script_set", "description": "대본 줄 쓰기(AI 초안)" },
    { "name": "voice_generate", "description": "대본 AI 음성 만들기 (say·ffmpeg 필요)" },
    { "name": "daemon_status", "description": "백그라운드 데몬 상태" }
  ],
  "compatibility": { "platforms": ["darwin"] }
}
