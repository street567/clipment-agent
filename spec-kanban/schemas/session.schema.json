{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "session",
 "type": "object",
 "required": [
  "id"
 ],
 "properties": {
  "schema": {
   "type": "integer"
  },
  "id": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "agent": {
   "type": "string",
   "pattern": "^[a-z0-9-]{1,20}$"
  },
  "machine": {
   "type": "string",
   "maxLength": 40
  },
  "lane": {
   "type": "string",
   "maxLength": 40
  },
  "agentKey": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,64}$"
  }
 },
 "additionalProperties": true
}
